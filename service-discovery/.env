# ========================================
# SERVICE DISCOVERY - LOCAL DEVELOPMENT
# ========================================

# Application
SPRING_APPLICATION_NAME=service-discovery
SPRING_PROFILES_ACTIVE=dev

# Server
PORT=8761

# Eureka Instance
EUREKA_INSTANCE_HOSTNAME=localhost
EUREKA_PREFER_IP=false

# HTTP Configuration (Local uses HTTP)
EUREKA_NON_SECURE_PORT_ENABLED=true
EUREKA_SECURE_PORT_ENABLED=false

# URLs for local (HTTP)
EUREKA_HOME_PAGE_URL=http://localhost:8761/
EUREKA_STATUS_PAGE_URL=http://localhost:8761/actuator/info
EUREKA_HEALTH_CHECK_URL=http://localhost:8761/actuator/health
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/

# Server Settings
EUREKA_SELF_PRESERVATION=false
EUREKA_EVICTION_INTERVAL=5000

# Logging
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_EUREKA=INFO
LOG_LEVEL_DISCOVERY=DEBUG
